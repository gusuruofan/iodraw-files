        <!-- ===== 侧边注释: 字段类型映射 ===== -->
        <mxCell id="n_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="320" width="220" height="310" as="geometry" />
        </mxCell>
        <mxCell id="n_title" value="fieldType 对应业务实体" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="320" width="220" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n_content" value="&lt;b&gt;field 表字段:&lt;/b&gt;&lt;br&gt;• id (BIGINT PK)&lt;br&gt;• field_type (INT)&lt;br&gt;• field_code (VARCHAR 50)&lt;br&gt;• field_name (VARCHAR 50)&lt;br&gt;• is_deleted (TINYINT)&lt;br&gt;&lt;br&gt;&lt;b&gt;类型枚举 (8种):&lt;/b&gt;&lt;br&gt;1 = Customer.source (客户来源)&lt;br&gt;2 = Customer.status (客户状态)&lt;br&gt;3 = Opportunity.source (商机来源)&lt;br&gt;4 = Opportunity.stage (商机阶段)&lt;br&gt;5 = Opportunity.status (商机状态)&lt;br&gt;6 = Order.orderType (订单类型)&lt;br&gt;7 = Contract.contractType (合同类型)&lt;br&gt;8 = Contract.status (合同状态)&lt;br&gt;&lt;br&gt;&lt;b&gt;约束:&lt;/b&gt;&lt;br&gt;UNIQUE KEY (field_type, field_code)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="928" y="348" width="204" height="274" as="geometry" />
        </mxCell>

        <!-- ===== 侧边注释: 缓存策略 ===== -->
        <mxCell id="c_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="670" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c_title" value="Redis 缓存策略" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="670" width="220" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c_content" value="&lt;b&gt;缓存键:&lt;/b&gt;&lt;br&gt;field:type:{fieldType}&lt;br&gt;如 field:type:1 = 客户来源&lt;br&gt;&lt;br&gt;&lt;b&gt;TTL: 24 小时&lt;/b&gt;&lt;br&gt;序列化: RedisTemplate&lt;br&gt;  &amp;lt;String, Object&amp;gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;失效时机:&lt;/b&gt;&lt;br&gt;任何 Create/Update/Delete&lt;br&gt;操作后立即删除对应 key&lt;br&gt;通过 clearFieldCache(type)&lt;br&gt;&lt;br&gt;&lt;b&gt;容错:&lt;/b&gt;&lt;br&gt;Redis 异常时降级为&lt;br&gt;直接查询 MySQL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="928" y="698" width="204" height="134" as="geometry" />
        </mxCell>

